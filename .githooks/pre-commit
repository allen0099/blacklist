#!/usr/bin/env sh
# pre-commit hook: reject commits that contain unformatted Go source files.
#
# Install via:
#   make install-hooks
# or manually:
#   git config core.hooksPath .githooks

set -e

# Exit early when there are no staged .go files (added, copied, modified).
if [ -z "$(git diff --cached --name-only --diff-filter=ACM -- '*.go' | head -n 1)" ]; then
    exit 0
fi

# Use NUL-delimited paths so filenames with spaces are passed safely to xargs.
UNFORMATTED=$(git diff --cached --name-only -z --diff-filter=ACM -- '*.go' | xargs -0 gofmt -l)

if [ -n "$UNFORMATTED" ]; then
    echo "❌  The following Go files are not formatted (run 'make fmt' or 'gofmt -w'):"
    echo "$UNFORMATTED" | sed 's/^/   /'
    exit 1
fi

exit 0
