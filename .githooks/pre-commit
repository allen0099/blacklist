#!/usr/bin/env sh
# pre-commit hook: reject commits that contain unformatted Go source files.
#
# Install via:
#   make install-hooks
# or manually:
#   git config core.hooksPath .githooks

set -e

# Collect staged .go files (added, copied, modified) safely.
if ! git diff --cached --name-only -z --diff-filter=ACM -- '*.go' | grep -qz .; then
    exit 0
fi

UNFORMATTED=$(git diff --cached --name-only -z --diff-filter=ACM -- '*.go' | xargs -0 gofmt -l)

if [ -n "$UNFORMATTED" ]; then
    echo "❌  The following Go files are not formatted (run 'make fmt' or 'gofmt -w'):"
    echo "$UNFORMATTED" | sed 's/^/   /'
    exit 1
fi

exit 0
